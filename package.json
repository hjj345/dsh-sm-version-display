{
  "name": "dsh-version-display",
  "version": "1.0.0",
  "description": "在 DeepSeek Harness Web GUI 侧边栏「设置」按钮上方显示 deepseek-harness 版本号的圆角卡片插件；内置 npm registry 更新检测（最新版 / 有更新 vX.Y.Z）。host 半区运行时读取已安装版本，dsh 升级后自动跟随，无需维护。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "version",
    "version-display",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check client/client.js",
    "build": "node --check lib/index.js && node --check client/client.js && node scripts/validate.mjs"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "hjj345",
  "homepage": "https://github.com/hjj345/sm-dsh-version-display"
}
